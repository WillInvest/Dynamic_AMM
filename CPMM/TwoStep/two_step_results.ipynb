    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Set the style for a modern, professional look\n",
    "# plt.style.use('seaborn')\n",
    "# sns.set_palette(\"husl\")\n",
    "\n",
    "df = pd.read_csv(\"/Users/haofu/Desktop/AMM/Dynamic_AMM/CPMM/TwoStep/results/two_step_lp_revenue.csv\")\n",
    "\n",
    "# Create figure with specific size\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "# Plot data with enhanced styling\n",
    "unique_sigmas = [0.3, 0.5, 0.9]\n",
    "# markers = ['o', 's', '^']  # Different markers for each line\n",
    "for i, sigma in enumerate(unique_sigmas):\n",
    "    sigma_df = df[df['sigma'] == sigma]\n",
    "    plt.plot(sigma_df['gamma'] * 10000, sigma_df['two_step_lp_revenue'],\n",
    "             linewidth=2.5,\n",
    "            #  marker=markers[i],\n",
    "             markersize=6,\n",
    "             label=f'σ = {sigma}',\n",
    "             alpha=0.8)\n",
    "\n",
    "# Customize the plot\n",
    "plt.title('Two-Step LP Revenue vs. Fee Rate for Different Volatility Levels',\n",
    "          fontsize=14, pad=15)\n",
    "plt.xlabel('Fee Rate (basis points)', fontsize=12, fontweight='bold')\n",
    "plt.ylabel('LP Revenue', fontsize=12, fontweight='bold')\n",
    "\n",
    "# Add grid with custom style\n",
    "plt.grid(True, linestyle='--')\n",
    "\n",
    "# Customize legend\n",
    "plt.legend(fontsize=16,\n",
    "          frameon=True,\n",
    "          facecolor='white',\n",
    "          edgecolor='none',\n",
    "          title='Volatility',\n",
    "          title_fontsize=10,\n",
    "          loc='best')\n",
    "\n",
    "# Use scientific notation for y-axis\n",
    "plt.ticklabel_format(style='sci', axis='y', scilimits=(0,0))\n",
    "\n",
    "# Adjust layout and display\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
