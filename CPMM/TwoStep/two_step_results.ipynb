    "import pandas as pd\n",
    "\n",
    "df_raw = pd.read_csv('/Users/haofu/Desktop/AMM/Dynamic_AMM/CPMM/TwoStep/results/two_step_result_theta_comparison.csv')\n",
    "\n",
    "df = df_raw.copy()\n",
    "x0 = 1e6\n",
    "y0 = 1e6\n",
    "\n",
    "df['initial_pool_value'] = (y0/x0) * (1-df['gamma'])**df['theta'] * x0 + y0\n",
    "df['lp_revenue'] = df['first_step_fee_revenue'] + df['second_step_fee_revenue'] + df['second_step_pool_value'] - df['initial_pool_value']\n",
    "df['total_fee_revenue'] = df['first_step_fee_revenue'] + df['second_step_fee_revenue']\n",
    "df['2single_fee_revenue'] = df['first_step_fee_revenue'] * 2\n",
    "df['fee_diff'] = df['total_fee_revenue'] - df['2single_fee_revenue']\n",
    "print(df.tail(10).to_markdown())"
   ]
  }
