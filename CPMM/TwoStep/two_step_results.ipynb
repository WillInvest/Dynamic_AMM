    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# Read the data\n",
    "df_raw = pd.read_csv(\"/Users/haofu/Desktop/AMM/Dynamic_AMM/CPMM/TwoStep/results/two_step_result_theta_comparison.csv\")\n",
    "df = df_raw.copy()\n",
    "# df = df[df['incoming_fee'] == False]\n",
    "\n",
    "# Get unique values\n",
    "sigmas = sorted(df['sigma'].unique())\n",
    "w_lists = [0.5]\n",
    "theta_lists = [0]\n",
    "\n",
    "# Calculate subplot layout\n",
    "n_sigmas = len(sigmas)\n",
    "n_cols = 3\n",
    "n_rows = int(np.ceil(n_sigmas / n_cols))\n",
    "\n",
    "# Create subplots\n",
    "fig, axes = plt.subplots(n_rows, n_cols, figsize=(15, 5*n_rows))\n",
    "\n",
    "# Handle case where we have only one row\n",
    "if n_rows == 1:\n",
    "    axes = axes.reshape(1, -1)\n",
    "elif n_sigmas == 1:\n",
    "    axes = axes.reshape(1, 1)\n",
    "\n",
    "# Flatten axes for easier indexing\n",
    "axes_flat = axes.flatten()\n",
    "\n",
    "# Plot for each sigma\n",
    "for i, sigma in enumerate(sigmas):\n",
    "    ax = axes_flat[i]\n",
    "    df_sigma = df[df['sigma'] == sigma]\n",
    "    \n",
    "    # Plot each w value as a separate line\n",
    "    for w in w_lists:\n",
    "        df_w = df_sigma.copy()\n",
    "        # df_w = df_w[df_w['w'] == w]\n",
    "        df_w['total_fee_revenue'] = df_w['first_step_fee_revenue'] + df_w['second_step_fee_revenue']\n",
    "        for theta in theta_lists:\n",
    "            df_theta = df_w.copy()\n",
    "            df_theta = df_theta[df_theta['theta'] == theta]\n",
    "            ax.plot(df_theta['gamma'], df_theta['total_fee_revenue'], \n",
    "                    label=f'w={w}', markersize=3, linewidth=2)\n",
    "            ax.plot(df_theta['gamma'], df_theta['first_step_fee_revenue'], \n",
    "                label=f'w={w}', markersize=3, linewidth=2, linestyle='-', color='red')\n",
    "            ax.plot(df_theta['gamma'], 2*df_theta['first_step_fee_revenue'], \n",
    "                    label=f'w={w}', markersize=3, linewidth=2, linestyle='--', color='red')\n",
    "    \n",
    "    ax.set_title(f'Sigma = {sigma}', fontsize=12, fontweight='bold')\n",
    "    ax.set_xlabel('Gamma')\n",
    "    ax.set_ylabel('Total Fee Revenue')\n",
    "    ax.legend()\n",
    "    ax.grid(True, alpha=0.3)\n",
    "\n",
    "# Hide unused subplots\n",
    "for i in range(n_sigmas, len(axes_flat)):\n",
