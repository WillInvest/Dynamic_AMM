    "plt.tight_layout()\n",
    "plt.suptitle('Total Fee Revenue Comparison Across Different Sigma and W Values', \n",
    "             fontsize=16, fontweight='bold', y=1.02)\n",
    "\n",
    "# Show the plot\n",
    "plt.show()"
